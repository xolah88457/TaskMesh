# ── LLM Provider ──────────────────────────────────────────────────────────────
# OpenCode Zen (active) — subscribe at https://opencode.ai/zen, copy your API key
# Variable name kept as OPENCODE_GO_API_KEY for backward compatibility.
# The actual service is OpenCode Zen at https://opencode.ai/zen/v1
OPENCODE_GO_API_KEY=your-opencode-zen-key-here

# OpenRouter (future — see base_agent.py and config_loader.py for switch instructions)
# OPENROUTER_API_KEY=sk-or-your-key-here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to true ONLY for local dev to bypass JWT verification.
# NEVER set to true in production — it disables all authentication and billing gates.
AUTH_DISABLED=false

# Signs all JWTs — generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# Where the frontend lives — the backend redirects here after OAuth callbacks.
# REQUIRED for split-origin deploys (e.g. Vercel frontend + Render backend).
# Omit for same-origin deploys or local dev (auto-derived from the request).
# FRONTEND_URL=https://your-frontend.vercel.app

# Google OAuth (for login) — GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Register these redirect URIs in the GCP Console:
#   http://localhost:8000/api/auth/google/callback  (dev)
#   https://your-backend.onrender.com/api/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI is now optional — the backend auto-derives it from the
# incoming request. Only set it if the auto-detection is wrong (e.g. double proxy).
# GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback

# GitHub OAuth (for LOGIN — signs users in, auto-links to their GitHub)
# Register these redirect URIs in the GitHub OAuth App:
#   http://localhost:8000/api/auth/github/callback  (dev)
#   https://your-backend.onrender.com/api/auth/github/callback  (prod)
GITHUB_AUTH_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_AUTH_CLIENT_SECRET=your-github-oauth-app-client-secret
# GITHUB_AUTH_REDIRECT_URI is now optional — same auto-detection as above.
# GITHUB_AUTH_REDIRECT_URI=https://your-backend.onrender.com/api/auth/github/callback

# Cookie SameSite policy — controls cross-origin cookie behavior.
#   strict: safest, but breaks split-origin (Vercel + Render)
#   lax:    allows top-level GET navigations (works for OAuth redirects)
#   none:   full cross-site, MUST set ENVIRONMENT=production for Secure flag
# COOKIE_SAMESITE=lax
# ENVIRONMENT=production          # forces Secure cookies (required for samesite=none)

# ── Database ───────────────────────────────────────────────────────────────────
# Cloud SQL socket (production): postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/project:region:instance
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/taskmesh

# Async pool tuning. Defaults: pool_size=20, max_overflow=20, pool_recycle=1800.
# Bump pool_size for higher concurrent-tenant load; keep recycle under your
# Postgres `idle_in_transaction_session_timeout`.
# DB_POOL_SIZE=20
# DB_POOL_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800

# ── Payments ───────────────────────────────────────────────────────────────────
# Create 5 products in Paddle: 2 subscriptions (Starter $30/mo, Pro $80/mo) and
# 3 one-time packs (Pack S $20, Pack M $50, Pack L $100). Paste the price IDs below.
#
# PADDLE_API_KEY=live_your-api-key-here           # or sandbox_... for testing
# PADDLE_WEBHOOK_SECRET=pdl_ntf_your-webhook-secret
# PADDLE_PRICE_STARTER=pri_...    # Starter subscription  ($30/mo → $15 credits,    50% allocation)
# PADDLE_PRICE_PRO=pri_...        # Pro subscription      ($80/mo → $48 credits,    60% allocation)
# PADDLE_PRICE_PACK_S=pri_...     # Credit Pack S one-time ($20   → $10 credits,    50% allocation)
# PADDLE_PRICE_PACK_M=pri_...     # Credit Pack M one-time ($50   → $27.50 credits, 55% allocation)
# PADDLE_PRICE_PACK_L=pri_...     # Credit Pack L one-time ($100  → $60 credits,    60% allocation)

# ── GitHub Code Push — legacy OAuth App (one-shot PR flow) ─────────────────────
# Used by /api/github/push (Pro plan, manual). Kept for backward compatibility.
# GITHUB_CLIENT_ID=your-github-oauth-app-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
# GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback

# ── GitHub App (Agent Teams data plane) ────────────────────────────────────────
# Used by Agent Teams to push generated files + run artifacts to the user's
# own repo. Create the App at https://github.com/settings/apps with:
#   - Repository contents: read & write
#   - Pull requests: read & write
#   - Metadata: read
#   - Installation callback URL: https://your-host/api/github/install/callback
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=taskmesh
# Inline PEM or a path to a .pem file. RS256-signed JWTs are minted from this.
# GITHUB_APP_PRIVATE_KEY=/etc/secrets/taskmesh-app.private-key.pem

# Toggle the GitHub gate on /api/teams* — set to "false" for dev so you can
# exercise the API without installing the App locally. Plan gate still applies.
# TEAMS_REQUIRE_GITHUB=true

# ── App ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PROJECT_DIR=./agent-output

# Per-run timeout in seconds. Runs exceeding this are cancelled automatically.
# Default 600 (10 minutes). Set to 0 to disable timeout.
# RUN_TIMEOUT_SECONDS=600

# Provider toggle — "zen" (default, OpenCode Zen) or "openrouter" (OpenRouter).
# When openrouter, set OPENROUTER_API_KEY instead of OPENCODE_GO_API_KEY.
# PROVIDER=zen

# Auth cookie SameSite policy. Defaults to "strict" — correct for local dev.
# Use "none" when frontend and backend live on different origins (e.g. Vercel
# frontend + Render backend); Socket.IO opens a direct cross-site connection
# and strict cookies are dropped there. "none" requires ENVIRONMENT=production
# (or the cookie is rejected as insecure).
# COOKIE_SAMESITE=strict

# CORS allowed origins for the backend. Defaults to "*" (dev only — warns at
# startup when used outside AUTH_DISABLED). In production set to your frontend
# URL(s), comma-separated.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Mark the deployment environment. When "production", the auth cookie is sent
# with Secure=true and several RuntimeWarnings are silenced.
# ENVIRONMENT=production

# Admin bypass — generates a Pro plan + $9999 credit balance from /api/billing/admin-bypass
# without touching Paddle. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_BYPASS_KEY=keep-this-secret
