# Set to true to bypass login redirect during local dev.
# Backend must also have AUTH_DISABLED=true for API calls to work without a real JWT.
VITE_AUTH_DISABLED=true

# Optional: point Socket.IO directly at your backend in production.
# Vercel rewrites don't forward WebSocket upgrade frames, so Socket.IO falls back to
# HTTP long-polling when proxied through Vercel. Set this to your backend URL in the
# Vercel dashboard to get real-time WebSocket push instead.
# In local dev, leave empty — the Vite dev server proxies /socket.io to localhost:8000.
# VITE_SOCKET_URL=https://taskmesh-api.onrender.com
